---
/**
 * Tide Archive visual system: the visitor moves from coastal arrival to fort interior.
 * Use real Fort Marlborough photography as primary evidence; editorial graphics remain secondary.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Benteng Marlborough — Panduan Sejarah & Kunjungan Bengkulu";
const description = "Panduan independen berbahasa Indonesia untuk memahami sejarah, arah kunjungan, dan persiapan praktis ke Benteng Marlborough di Kota Bengkulu.";
const mapLink = "https://maps.app.goo.gl/PmRDYbcDPFJLHT4E6";
const tourismSource = "https://siparta.bengkulukota.go.id/wisata/benteng-marlborough";
const cityTourism = "https://pariwisata.bengkulukota.go.id/";
const commonsSource = "https://commons.wikimedia.org/";
const gatePhoto = "https://commons.wikimedia.org/wiki/Special:FilePath/Front%20gate%20of%20Fort%20Marlborough%2C%20Bengkulu%202015-04-19%2002.jpg";
const courtyardPhoto = "https://commons.wikimedia.org/wiki/Special:FilePath/Fort%20Marlborough%20-%20Bengkulu.jpg";
const signPhoto = "https://commons.wikimedia.org/wiki/Special:FilePath/Benteng%20Marlborough%20Bengkulu.jpg";

const attractionSchema = {
  "@context": "https://schema.org",
  "@type": ["TouristAttraction", "LocalBusiness"],
  name: "Benteng Marlborough",
  description,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Benteng, Kebun Keling, Kec. Teluk Segara",
    addressLocality: "Kota Bengkulu",
    addressRegion: "Bengkulu",
    postalCode: "38116",
    addressCountry: "ID"
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -3.7873176,
    longitude: 102.2491008
  },
  openingHoursSpecification: [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "08:00",
    closes: "17:00"
  }],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.6",
    ratingCount: "9826",
    bestRating: "5",
    worstRating: "1"
  },
  image: gatePhoto,
  sameAs: [tourismSource, mapLink]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "Apa itu Benteng Marlborough?", acceptedAnswer: { "@type": "Answer", text: "Benteng Marlborough adalah benteng peninggalan Inggris di Kota Bengkulu. Portal pariwisata Kota Bengkulu menyebutnya dibangun oleh East India Company pada 1714–1719 untuk memperkuat posisinya di pantai barat Sumatra dan mengamankan perdagangan lada." } },
    { "@type": "Question", name: "Kapan waktu yang baik untuk berkunjung?", acceptedAnswer: { "@type": "Answer", text: "Pagi atau sore biasanya terasa lebih nyaman untuk berjalan di ruang terbuka. Cuaca pesisir dapat berubah; bawa pelindung dari panas dan hujan." } },
    { "@type": "Question", name: "Bagaimana menuju Benteng Marlborough dari bandara?", acceptedAnswer: { "@type": "Answer", text: "Dari Bandar Udara Fatmawati Soekarno, pengunjung dapat melanjutkan dengan taksi, layanan transportasi daring, atau kendaraan sewaan menuju pusat Kota Bengkulu. Periksa rute dan waktu tempuh pada hari perjalanan." } },
    { "@type": "Question", name: "Apakah tersedia parkir dan toilet?", acceptedAnswer: { "@type": "Answer", text: "Ketersediaan fasilitas dan kondisi parkir dapat berubah mengikuti pengelolaan dan kegiatan di lokasi. Datang lebih awal bila membawa kendaraan, dan tanyakan kepada petugas saat tiba." } },
    { "@type": "Question", name: "Berapa harga tiket masuknya?", acceptedAnswer: { "@type": "Answer", text: "Biaya kunjungan dan kebijakan kategori pengunjung dapat berubah. Konfirmasikan langsung pada pengelola sebelum berangkat atau saat tiba di lokasi." } }
  ]
};
---

<BaseLayout {title} {description} lang="id" alternatePath="/en/" alternateLang="en">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <a class="skip-link" href="#isi">Lewati ke isi utama</a>

  <header class="site-header" data-header>
    <a class="brand" href="#beranda" aria-label="Beranda Benteng Marlborough">
      <img src="/mark.svg" alt="Tanda Benteng Marlborough" width="56" height="56" />
      <span class="brand-copy"><strong>BENTENG</strong><span>Marlborough</span></span>
    </a>
    <nav class="main-nav" aria-label="Navigasi utama">
      <a href="#sejarah">Sejarah</a>
      <a href="#jelajah">Jelajah</a>
      <a href="#kunjungan">Kunjungan</a>
      <a href="#faq">Tanya jawab</a>
    </nav>
    <div class="header-tools"><a class="header-map-link" href={mapLink} target="_blank" rel="noreferrer">Buka peta <span aria-hidden="true">↗</span></a><a class="header-lang-link" href="/en/" lang="en" hreflang="en">EN</a></div>
  </header>

  <main id="isi">
    <section id="beranda" class="hero" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        <img src={gatePhoto} alt="" />
        <div class="hero-wash"></div>
      </div>
      <div class="hero-content page-shell">
        <div class="eyebrow"><span></span> PANDUAN KUNJUNGAN INDEPENDEN · KOTA BENGKULU</div>
        <div class="hero-grid">
          <div>
            <p class="hero-kicker">Dari pantai barat Sumatra</p>
            <h1 id="hero-title">Membaca jejak<br /><em>di balik</em> batu.</h1>
            <p class="hero-intro">Benteng Marlborough bukan sekadar bangunan tua. Ia adalah pintu untuk memahami sejarah perdagangan, pesisir, dan Kota Bengkulu dari dekat.</p>
            <div class="hero-actions">
              <a class="button button-solid" href="#sejarah">Mulai dari sejarah <span aria-hidden="true">↓</span></a>
              <a class="button button-quiet" href={mapLink} target="_blank" rel="noreferrer">Lihat lokasi <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="at-a-glance" aria-label="Ringkasan Benteng Marlborough">
            <span class="card-label">RINGKASAN LOKASI</span>
            <dl>
              <div><dt>Jenis</dt><dd>Cagar sejarah</dd></div>
              <div><dt>Wilayah</dt><dd>Teluk Segara, Bengkulu</dd></div>
              <div><dt>Koordinat</dt><dd>3°47′14″ LS<br />102°14′57″ BT</dd></div>
              <div><dt>Skor publik</dt><dd>4,6 <small>/ 5</small></dd></div>
            </dl>
            <p>Skor publik dapat berubah. Untuk arah dan keadaan terkini, gunakan peta sebelum berangkat.</p>
          </aside>
        </div>
      </div>
      <div class="hero-caption">GERBANG UTAMA · FOTO DOKUMENTASI, SUMBER WIKIMEDIA COMMONS</div>
    </section>

    <section class="route-strip" aria-label="Alur halaman">
      <div class="page-shell route-inner">
        <span>01 · LATAR</span><i></i><span>02 · RUANG</span><i></i><span>03 · DATANG</span><i></i><span>04 · SEKITAR</span>
      </div>
    </section>

    <section id="sejarah" class="chapter history-section page-shell" aria-labelledby="history-title">
      <div class="chapter-index">01<span>ARSIP<br />PESISIR</span></div>
      <div class="chapter-body">
        <p class="section-label">SEBUAH BENTENG DI TEPI LAUT</p>
        <h2 id="history-title">Sejarah yang tidak berhenti pada <em>tembok.</em></h2>
        <div class="prose-grid">
          <p class="lead">Menurut portal informasi pariwisata Kota Bengkulu, Benteng Marlborough dibangun oleh East India Company Inggris pada 1714–1719 di bawah pimpinan Joseph Callet. Pembangunannya berkaitan dengan upaya menguatkan posisi Inggris di pantai barat Sumatra dan menjaga perdagangan lada.[<a href={tourismSource} target="_blank" rel="noreferrer">1</a>]</p>
          <p>Bangunan ini menempatkan jejak global di dalam lanskap lokal: jalur laut, pertukaran komoditas, perjumpaan masyarakat, serta pergantian kekuasaan. Saat berkunjung, perhatikan perubahan ketinggian tanah, bukaan gerbang, dan halaman dalam—semuanya membantu menjelaskan mengapa benteng dirancang untuk mengawasi ruang di sekitarnya.</p>
        </div>
        <aside class="archive-note" aria-label="Catatan arsip lokasi">
          <div class="archive-note-seal"><img src="/mark.svg" alt="" width="34" height="34" /></div>
          <div><span>CATATAN LAPANGAN 01</span><strong>1714–1719</strong><p>Rentang pembangunan yang dicatat oleh portal pariwisata Kota Bengkulu.</p></div>
          <i aria-hidden="true"></i>
          <div><span>ACUAN LOKASI</span><strong>Teluk Segara</strong><p>Koridor kota dan pesisir yang membingkai pengalaman kunjungan.</p></div>
        </aside>
        <figure class="wide-figure figure-courtyard">
          <img src={courtyardPhoto} alt="Halaman dalam Benteng Marlborough dengan dinding putih dan area rumput" loading="lazy" />
          <figcaption><span>02</span> Halaman dalam menghubungkan ruang terbuka, teras, dan bangunan benteng. Foto: Wikimedia Commons.</figcaption>
        </figure>
      </div>
    </section>

    <section id="jelajah" class="chapter explore-section" aria-labelledby="explore-title">
      <div class="bastion-pattern" aria-hidden="true"></div>
      <div class="page-shell explore-layout">
        <div class="chapter-index light">02<span>MEMBACA<br />RUANG</span></div>
        <div class="explore-copy">
          <p class="section-label light-label">CARA MENJELAJAH DENGAN PELAN</p>
          <h2 id="explore-title">Ikuti urutan ruang, bukan hanya <em>foto.</em></h2>
          <p>Mulailah dari gerbang dan jembatan, lalu beri waktu untuk melihat halaman, jalur tepi dinding, dan bukaan yang mengarah ke kota maupun laut. Sudut-sudut ini lebih bermakna bila dibaca sebagai satu rangkaian pertahanan dan kehidupan sehari-hari.</p>
          <ol class="walk-list">
            <li><span>01</span><div><strong>Masuk melalui gerbang</strong><p>Amati peralihan dari kota ke ruang benteng dan ukuran elemen batu di pintu masuk.</p></div></li>
            <li><span>02</span><div><strong>Berjalan mengelilingi halaman</strong><p>Jaga jarak dari area terlarang dan ikuti arahan petugas untuk melindungi struktur bersejarah.</p></div></li>
            <li><span>03</span><div><strong>Berhenti di sisi terbuka</strong><p>Bandingkan arah benteng dengan garis pesisir dan kepadatan kota di sekitarnya.</p></div></li>
          </ol>
          <aside class="route-register" aria-label="Catatan rute jelajah">
            <span>RUTE AMATAN</span><div class="route-line"><b></b><b></b><b></b></div><p>Gerbang → halaman → sisi terbuka. Ikuti jalur yang diizinkan dan tanda arahan di lokasi.</p>
          </aside>
        </div>
        <figure class="vertical-figure">
          <img src={signPhoto} alt="Penanda Fort Marlborough di halaman rumput" loading="lazy" />
          <figcaption>Ruang luar dan penanda situs. Foto: Wikimedia Commons.</figcaption>
        </figure>
      </div>
    </section>

    <section id="kunjungan" class="chapter visit-section page-shell" aria-labelledby="visit-title">
      <div class="chapter-index">03<span>SIAP<br />DATANG</span></div>
      <div class="chapter-body">
        <p class="section-label">CATATAN PRAKTIS</p>
        <h2 id="visit-title">Persiapan sederhana, kunjungan lebih <em>tenang.</em></h2>
        <p class="visit-intro">Informasi operasional dapat berubah karena kegiatan, perawatan, atau kebijakan pengelola. Gunakan bagian ini sebagai daftar persiapan, lalu konfirmasikan hal penting sebelum berangkat.</p>
        <div class="practical-table" role="table" aria-label="Informasi praktis kunjungan">
          <div class="practical-row" role="row"><div role="cell"><span class="row-num">A</span><strong>Jam & biaya</strong></div><p role="cell">Rujukan umum menyebut waktu siang hari, sekitar <b>08.00–17.00 WIB</b>. Harga tiket dan ketentuan kategori pengunjung perlu dicek langsung di lokasi.</p><a role="cell" href={tourismSource} target="_blank" rel="noreferrer">Cek sumber ↗</a></div>
          <div class="practical-row" role="row"><div role="cell"><span class="row-num">B</span><strong>Waktu terbaik</strong></div><p role="cell">Pagi atau sore lebih nyaman untuk berjalan. Siapkan air minum, pelindung matahari, dan payung lipat saat musim hujan.</p><a role="cell" href="#faq">Lihat FAQ ↓</a></div>
          <div class="practical-row" role="row"><div role="cell"><span class="row-num">C</span><strong>Parkir & fasilitas</strong></div><p role="cell">Ketersediaan parkir, toilet, tempat duduk, dan aksesibilitas perlu diverifikasi di hari kunjungan; kondisi dapat berubah saat ada acara.</p><a role="cell" href={mapLink} target="_blank" rel="noreferrer">Buka peta ↗</a></div>
          <div class="practical-row" role="row"><div role="cell"><span class="row-num">D</span><strong>Etika lokasi</strong></div><p role="cell">Hormati jalur yang ditandai, jangan memanjat struktur, dan bawa kembali sampah pribadi. Bangunan bersejarah lebih terjaga oleh kunjungan yang pelan dan sadar.</p><a role="cell" href="#sejarah">Baca latar ↓</a></div>
        </div>
      </div>
    </section>

    <section class="journey-section" aria-labelledby="journey-title">
      <div class="page-shell journey-layout">
        <div class="journey-heading">
          <p class="section-label">DARI BERBAGAI ARAH</p>
          <h2 id="journey-title">Arah datang ke <em>Teluk Segara.</em></h2>
        </div>
        <div class="journey-cards">
          <article><span>01</span><h3>Dari bandara</h3><p>Dari Bandar Udara Fatmawati Soekarno, lanjutkan dengan taksi, layanan transportasi daring, atau kendaraan sewaan menuju pusat Kota Bengkulu. Periksa rute dan waktu tempuh menjelang perjalanan.</p></article>
          <article><span>02</span><h3>Dari terminal & kota</h3><p>Jika memakai angkutan umum atau angkot, pastikan jalur turun terdekat dan ketersediaan perjalanan pulang. Alternatifnya, lanjutkan dengan taksi atau ojek setempat.</p></article>
          <article><span>03</span><h3>Dari pesisir</h3><p>Benteng berada dekat koridor Pantai Tapak Paderi. Untuk perjalanan jalan kaki dari kawasan pesisir, perhatikan panas, lalu lintas, dan kondisi trotoar.</p></article>
        </div>
      </div>
    </section>

    <section class="map-section page-shell" aria-labelledby="map-title">
      <div class="map-meta">
        <p class="section-label">POSISI</p>
        <h2 id="map-title">Satu titik, banyak jalur <em>cerita.</em></h2>
        <address>Jl. Benteng, Kebun Keling, Kec. Teluk Segara,<br />Kota Bengkulu, Bengkulu 38116, Indonesia</address>
        <a class="text-link" href={mapLink} target="_blank" rel="noreferrer">Buka di Google Maps <span aria-hidden="true">↗</span></a>
      </div>
      <div class="map-frame">
        <iframe title="Peta Benteng Marlborough" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6878.810349279519!2d102.24910077688843!3d-3.7873176434786617!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e36afd779f07007%3A0x3c0143f4c64a7e4d!2sFort%20Marlborough!5e1!3m2!1sid!2sid!4v1787019589118!5m2!1sid!2sid" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </section>

    <section class="around-section" aria-labelledby="around-title">
      <div class="page-shell">
        <div class="around-heading"><p class="section-label light-label">SEKITAR BENTENG</p><h2 id="around-title">Lanjutkan dengan rasa ingin <em>tahu.</em></h2></div>
        <div class="around-grid">
          <article><span>01</span><h3>Ruang pesisir</h3><p><strong>Pantai Tapak Paderi</strong> berada di koridor pesisir dekat benteng. Gunakan sebagai konteks geografis, bukan sekadar tempat berhenti setelah berfoto.</p></article>
          <article><span>02</span><h3>Jejak kota</h3><p><strong>Kampung Cina</strong> dan kawasan kota lama membantu membaca beragam lapisan perdagangan dan kehidupan urban Bengkulu.</p></article>
          <article><span>03</span><h3>Sejarah nasional</h3><p><strong>Rumah Pengasingan Bung Karno</strong> dapat menjadi perhentian lanjutan untuk memahami periode berbeda dalam sejarah kota.</p></article>
          <article><span>04</span><h3>Kebutuhan perjalanan</h3><p>Di pusat kota tersedia beragam jenis warung makan, penginapan, minimarket, ATM, bengkel, SPBU, dan titik pengisian kendaraan. Pilih sesuai kebutuhan tanpa rekomendasi komersial.</p></article>
        </div>
      </div>
    </section>

    <section class="food-section page-shell" aria-labelledby="food-title">
      <div class="food-illustration" aria-hidden="true"><div class="seal-field"><span>RUTE KOTA</span><img src="/mark.svg" alt="" width="112" height="112" /><b>03°47′14″ LS</b><i></i><b>102°14′57″ BT</b></div></div>
      <div class="food-copy">
        <p class="section-label">MAKAN & ISTIRAHAT</p>
        <h2 id="food-title">Cari jeda, lalu temukan rasa <em>kota.</em></h2>
        <p>Untuk makan, pilih jenis tempat yang sesuai ritme perjalanan: warung sederhana untuk hidangan cepat, rumah makan keluarga untuk waktu istirahat lebih panjang, atau kedai minum di pusat kota. Bengkulu dikenal dengan tradisi kuliner berempah; tanyakan komposisi bila Anda memiliki kebutuhan makan khusus.</p>
        <p class="muted-note">Panduan ini tidak mempromosikan usaha tertentu. Jam buka, pilihan makanan, dan kebutuhan halal/vegetarian sebaiknya dikonfirmasi langsung kepada penyedia layanan.</p>
      </div>
    </section>

    <section id="faq" class="chapter faq-section page-shell" aria-labelledby="faq-title">
      <div class="chapter-index">04<span>TANYA<br />JAWAB</span></div>
      <div class="chapter-body">
        <p class="section-label">HAL YANG SERING DITANYAKAN</p>
        <h2 id="faq-title">Jawaban sebelum Anda melangkah <em>masuk.</em></h2>
        <div class="faq-list">
          <details open><summary>Untuk apa Benteng Marlborough dibangun?<span>+</span></summary><p>Menurut informasi pariwisata Kota Bengkulu, benteng ini didirikan oleh East India Company Inggris pada 1714–1719 untuk memperkuat posisi Inggris di pantai barat Sumatra dan melindungi perdagangan lada.[<a href={tourismSource} target="_blank" rel="noreferrer">1</a>]</p></details>
          <details><summary>Berapa lama waktu yang ideal di lokasi?<span>+</span></summary><p>Sisihkan sekitar 60–120 menit untuk berjalan dengan pelan, membaca panel yang tersedia, dan memberi waktu untuk arah ruang di dalam benteng. Durasi dapat berubah mengikuti akses area dan ketentuan hari itu.</p></details>
          <details><summary>Apakah perlu membeli tiket lebih dahulu?<span>+</span></summary><p>Ketentuan tiket dapat berubah. Pastikan langsung kepada pengelola atau cek informasi pariwisata setempat sebelum memulai perjalanan.</p></details>
          <details><summary>Apakah aman membawa anak atau lansia?<span>+</span></summary><p>Rencanakan ritme berjalan sesuai kondisi masing-masing, perhatikan permukaan lantai dan paparan matahari, serta dampingi anak di dekat tepi struktur. Tanyakan akses yang tersedia saat tiba.</p></details>
          <details><summary>Apakah ada toilet dan tempat duduk?<span>+</span></summary><p>Fasilitas dapat tersedia namun kondisinya tidak selalu sama setiap hari. Portal wisata Kota Bengkulu memasukkan toilet dan tempat duduk sebagai bagian dari evaluasi pengalaman lokasi; tetap cek langsung di hari kunjungan.[<a href={tourismSource} target="_blank" rel="noreferrer">1</a>]</p></details>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-shell footer-grid">
      <div class="footer-brand"><img src="/mark.svg" alt="" width="44" height="44" /><p><strong>Panduan Benteng Marlborough</strong><br />Membaca pesisir, sejarah, dan kesiapan berkunjung dengan lebih tenang.</p></div>
      <div class="footer-links"><a href={tourismSource} target="_blank" rel="noreferrer">Informasi wisata Kota Bengkulu ↗</a><a href={cityTourism} target="_blank" rel="noreferrer">Dinas Pariwisata Kota Bengkulu ↗</a><a href={commonsSource} target="_blank" rel="noreferrer">Sumber foto Wikimedia Commons ↗</a></div>
      <div class="footer-legal"><button data-dialog="privacy-dialog">Kebijakan privasi</button><button data-dialog="terms-dialog">Ketentuan penggunaan</button><button data-dialog="cookie-dialog">Pengaturan cookie</button></div>
    </div>
    <div class="page-shell footer-bottom"><p>Proyek panduan informasi pengunjung yang independen dan nirlaba; tidak berafiliasi dengan pengelola resmi, pemerintah, atau organisasi komersial mana pun.</p><p>© 2026 Panduan Benteng Marlborough.</p></div>
  </footer>

  <dialog id="privacy-dialog" class="legal-dialog" aria-labelledby="privacy-title"><div><button class="dialog-close" data-close-dialog aria-label="Tutup">×</button><p class="section-label">PRIVASI</p><h2 id="privacy-title">Kebijakan privasi</h2><p class="dialog-updated">Diperbarui: Agustus 2026</p><h3>Informasi yang kami proses</h3><p>Kami berupaya membatasi pemrosesan data pada yang diperlukan untuk menjalankan situs, seperti data teknis penayangan, preferensi cookie, dan informasi yang Anda kirimkan sendiri melalui kanal kontak yang tersedia.</p><h3>Untuk apa digunakan</h3><p>Data dapat digunakan untuk memahami pola penggunaan secara agregat, memperbaiki isi panduan, menanggapi permintaan, dan memenuhi kewajiban hukum yang berlaku.</p><h3>Layanan pihak ketiga</h3><p>Peta Google dan Google Analytics dapat memproses data berdasarkan kebijakan masing-masing. Analitik hanya dimuat setelah Anda menyetujui cookie analitik.</p><h3>Hak Anda</h3><p>Anda dapat meminta akses, koreksi, penghapusan, pembatasan, atau menyampaikan keberatan sesuai hukum perlindungan data yang berlaku.</p></div></dialog>
  <dialog id="terms-dialog" class="legal-dialog" aria-labelledby="terms-title"><div><button class="dialog-close" data-close-dialog aria-label="Tutup">×</button><p class="section-label">PENGGUNAAN</p><h2 id="terms-title">Ketentuan penggunaan</h2><p class="dialog-updated">Diperbarui: Agustus 2026</p><p>Dengan menggunakan panduan ini, Anda memahami bahwa seluruh isi disajikan untuk informasi umum. Situs ini merupakan panduan pihak ketiga yang independen dan tidak berafiliasi dengan pengelola lokasi, instansi pemerintah, atau pelaku usaha.</p><p>Kami berupaya merangkum informasi publik secara hati-hati, namun tidak menjamin kelengkapan atau ketepatan kondisi terkini. Waktu kunjungan, akses, biaya, layanan, dan ketentuan dapat berubah tanpa pemberitahuan. Verifikasi keputusan perjalanan yang penting langsung pada sumber resmi.</p><p>Tulisan asli situs ini dilindungi hak cipta. Hak atas gambar tetap berada pada fotografer atau pemegang hak terkait; sumber foto dicantumkan pada halaman.</p></div></dialog>
  <dialog id="cookie-dialog" class="legal-dialog cookie-dialog" aria-labelledby="cookie-title"><div><button class="dialog-close" data-close-dialog aria-label="Tutup">×</button><p class="section-label">PREFERENSI</p><h2 id="cookie-title">Pengaturan cookie</h2><p class="dialog-updated">Diperbarui: Agustus 2026</p><div class="cookie-option"><div><strong>Cookie penting</strong><p>Diperlukan untuk fungsi dasar situs dan tidak dapat dimatikan.</p></div><span>Selalu aktif</span></div><label class="cookie-option"><div><strong>Cookie analitik</strong><p>Membantu memahami penggunaan situs secara agregat melalui Google Analytics.</p></div><input type="checkbox" id="analytics-choice" /><span class="switch" aria-hidden="true"></span></label><div class="cookie-actions"><button class="button button-quiet" data-reject-cookies>Tolak semua</button><button class="button button-solid" data-save-cookies>Simpan preferensi</button></div></div></dialog>

  <button class="cookie-prompt" data-open-cookie aria-label="Atur cookie">Preferensi cookie</button>

  <script>
    const storageKey = "benteng-marlborough-analytics";
    const cookieDialog = document.querySelector<HTMLDialogElement>("#cookie-dialog");
    const analyticsChoice = document.querySelector<HTMLInputElement>("#analytics-choice");
    document.querySelectorAll<HTMLButtonElement>("[data-dialog]").forEach((button) => {
      button.addEventListener("click", () => document.querySelector<HTMLDialogElement>(`#${button.dataset.dialog}`)?.showModal());
    });
    document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]").forEach((button) => button.addEventListener("click", () => button.closest("dialog")?.close()));
    document.querySelector<HTMLButtonElement>("[data-open-cookie]")?.addEventListener("click", () => cookieDialog?.showModal());
    document.querySelector<HTMLButtonElement>("[data-save-cookies]")?.addEventListener("click", () => {
      const choice = analyticsChoice?.checked ? "granted" : "denied";
      localStorage.setItem(storageKey, choice);
      if (choice === "granted") window.dispatchEvent(new Event("benteng:analytics-consent"));
      cookieDialog?.close();
    });
    document.querySelector<HTMLButtonElement>("[data-reject-cookies]")?.addEventListener("click", () => {
      localStorage.setItem(storageKey, "denied");
      if (analyticsChoice) analyticsChoice.checked = false;
      cookieDialog?.close();
    });
    if (analyticsChoice) analyticsChoice.checked = localStorage.getItem(storageKey) === "granted";
  </script>
</BaseLayout>
