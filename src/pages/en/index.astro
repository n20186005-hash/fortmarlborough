---
/**
 * Tide Archive visual system: English field-guide edition.
 * Real Fort Marlborough photography remains primary evidence; map marks remain secondary.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Fort Marlborough — History & Visitor Guide, Bengkulu";
const description = "An independent English guide to Fort Marlborough in Bengkulu: its history, visitor planning, arrival routes, nearby context, map and practical questions.";
const mapLink = "https://maps.app.goo.gl/PmRDYbcDPFJLHT4E6";
const tourismSource = "https://siparta.bengkulukota.go.id/wisata/benteng-marlborough";
const cityTourism = "https://pariwisata.bengkulukota.go.id/";
const commonsSource = "https://commons.wikimedia.org/";
const gatePhoto = "https://commons.wikimedia.org/wiki/Special:FilePath/Front%20gate%20of%20Fort%20Marlborough%2C%20Bengkulu%202015-04-19%2002.jpg";
const courtyardPhoto = "https://commons.wikimedia.org/wiki/Special:FilePath/Fort%20Marlborough%20-%20Bengkulu.jpg";
const signPhoto = "https://commons.wikimedia.org/wiki/Special:FilePath/Benteng%20Marlborough%20Bengkulu.jpg";

const attractionSchema = {
  "@context": "https://schema.org",
  "@type": ["TouristAttraction", "LocalBusiness"],
  name: "Fort Marlborough",
  alternateName: "Benteng Marlborough",
  description,
  address: { "@type": "PostalAddress", streetAddress: "Jl. Benteng, Kebun Keling, Kec. Teluk Segara", addressLocality: "Bengkulu City", addressRegion: "Bengkulu", postalCode: "38116", addressCountry: "ID" },
  geo: { "@type": "GeoCoordinates", latitude: -3.7873176, longitude: 102.2491008 },
  openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "08:00", closes: "17:00" }],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.6", ratingCount: "9826", bestRating: "5", worstRating: "1" },
  image: gatePhoto,
  sameAs: [tourismSource, mapLink]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What is Fort Marlborough?", acceptedAnswer: { "@type": "Answer", text: "Fort Marlborough is a former British fort in Bengkulu City. The City of Bengkulu tourism portal states that it was built by the East India Company from 1714 to 1719 to strengthen the British position on Sumatra's west coast and secure the pepper trade." } },
    { "@type": "Question", name: "When is the best time to visit?", acceptedAnswer: { "@type": "Answer", text: "Morning or late afternoon is generally more comfortable for walking outdoors. Coastal weather can change quickly, so bring protection from sun and rain." } },
    { "@type": "Question", name: "How do I reach the fort from the airport?", acceptedAnswer: { "@type": "Answer", text: "From Fatmawati Soekarno Airport, continue towards central Bengkulu by taxi, ride-hailing service or hired vehicle. Check your route and travel time on the day." } },
    { "@type": "Question", name: "Are parking and toilets available?", acceptedAnswer: { "@type": "Answer", text: "Facility and parking availability can vary with maintenance and local events. Arrive early when driving and ask staff on arrival." } },
    { "@type": "Question", name: "How much is admission?", acceptedAnswer: { "@type": "Answer", text: "Admission and visitor-category policies can change. Confirm with the site manager before leaving or on arrival." } }
  ]
};
---

<BaseLayout {title} {description} lang="en" alternatePath="/" alternateLang="id">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <a class="skip-link" href="#content">Skip to main content</a>

  <header class="site-header" data-header>
    <a class="brand" href="#home" aria-label="Fort Marlborough home">
      <img src="/mark.svg" alt="Fort Marlborough mark" width="56" height="56" />
      <span class="brand-copy"><strong>BENTENG</strong><span>Marlborough</span></span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="#history">History</a>
      <a href="#explore">Explore</a>
      <a href="#visit">Visit</a>
      <a href="#faq">Questions</a>
    </nav>
    <div class="header-tools"><a class="header-map-link" href={mapLink} target="_blank" rel="noreferrer">Open map <span aria-hidden="true">↗</span></a><a class="header-lang-link" href="/" lang="id" hreflang="id">ID</a></div>
  </header>

  <main id="content">
    <section id="home" class="hero" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true"><img src={gatePhoto} alt="" /><div class="hero-wash"></div></div>
      <div class="hero-content page-shell">
        <div class="eyebrow"><span></span> INDEPENDENT VISITOR GUIDE · BENGKULU CITY</div>
        <div class="hero-grid">
          <div>
            <p class="hero-kicker">From Sumatra's west coast</p>
            <h1 id="hero-title">Read the traces<br /><em>behind</em> the stone.</h1>
            <p class="hero-intro">Fort Marlborough is more than an old structure. It is an entry point for understanding trade, coastline and city life in Bengkulu.</p>
            <div class="hero-actions"><a class="button button-solid" href="#history">Start with history <span aria-hidden="true">↓</span></a><a class="button button-quiet" href={mapLink} target="_blank" rel="noreferrer">See location <span aria-hidden="true">↗</span></a></div>
          </div>
          <aside class="at-a-glance" aria-label="Fort Marlborough at a glance">
            <span class="card-label">AT A GLANCE</span>
            <dl><div><dt>Type</dt><dd>Historic site</dd></div><div><dt>District</dt><dd>Teluk Segara, Bengkulu</dd></div><div><dt>Coordinates</dt><dd>3°47′14″ S<br />102°14′57″ E</dd></div><div><dt>Public score</dt><dd>4.6 <small>/ 5</small></dd></div></dl>
            <p>Public scores can change. Open the map before departure for directions and current conditions.</p>
          </aside>
        </div>
      </div>
      <div class="hero-caption">MAIN GATE · DOCUMENTARY PHOTO, WIKIMEDIA COMMONS</div>
    </section>

    <section class="route-strip" aria-label="Page route"><div class="page-shell route-inner"><span>01 · CONTEXT</span><i></i><span>02 · SPACE</span><i></i><span>03 · ARRIVE</span><i></i><span>04 · AROUND</span><i></i><span>05 · ASK</span></div></section>

    <section id="history" class="chapter history-section page-shell" aria-labelledby="history-title">
      <div class="chapter-index">01<span>COASTAL<br />ARCHIVE</span></div>
      <div class="chapter-body">
        <p class="section-label">A FORT BY THE SEA</p>
        <h2 id="history-title">History does not end at the <em>walls.</em></h2>
        <div class="prose-grid"><p class="lead">Bengkulu City's tourism information portal records that Fort Marlborough was built by the British East India Company between 1714 and 1719 under Joseph Callet. Its construction was tied to strengthening the British position on Sumatra's west coast and securing the pepper trade.[<a href={tourismSource} target="_blank" rel="noreferrer">1</a>]</p><p>The fort puts a global history inside a local landscape: sea routes, commodities, community encounters and changing administrations. Notice the changes in ground level, gateways and inner court as you visit; they help explain why the site was designed to watch the surrounding space.</p></div>
        <aside class="archive-note" aria-label="Site archive note"><div class="archive-note-seal"><img src="/mark.svg" alt="" width="34" height="34" /></div><div><span>FIELD NOTE 01</span><strong>1714–1719</strong><p>Construction years recorded by Bengkulu City's tourism portal.</p></div><i aria-hidden="true"></i><div><span>LOCATION REFERENCE</span><strong>Teluk Segara</strong><p>The coastal-city corridor that frames a visit to the fort.</p></div></aside>
        <figure class="wide-figure figure-courtyard"><img src={courtyardPhoto} alt="The inner courtyard of Fort Marlborough, with white walls and a grassed area" loading="lazy" /><figcaption><span>02</span> The inner court connects open space, terraces and fort buildings. Photo: Wikimedia Commons.</figcaption></figure>
      </div>
    </section>

    <section id="explore" class="explore-section" aria-labelledby="explore-title">
      <div class="bastion-pattern" aria-hidden="true"></div>
      <div class="page-shell explore-layout">
        <div class="chapter-index light">02<span>READING<br />SPACE</span></div>
        <div class="explore-card">
          <div class="explore-copy"><p class="section-label">A SLOWER WAY TO EXPLORE</p><h2 id="explore-title">Follow the spaces, not only the <em>photos.</em></h2><p>Begin at the gate and bridge, then give time to the courtyard, the paths beside the walls and the views that open toward the city and sea. These corners become more meaningful when read as one chain of defence and everyday life.</p><ol class="walk-list"><li><span>01</span><div><strong>Enter through the gate</strong><p>Notice the transition from the city into the fort, and the scale of stonework at the entrance.</p></div></li><li><span>02</span><div><strong>Walk around the courtyard</strong><p>Keep away from restricted areas and follow staff guidance to help protect historic fabric.</p></div></li><li><span>03</span><div><strong>Pause at the open edge</strong><p>Compare the fort's direction with the coastline and the city beyond it.</p></div></li></ol><aside class="route-register" aria-label="Exploration route note"><span>OBSERVATION ROUTE</span><div class="route-line"><b></b><b></b><b></b></div><p>Gate → courtyard → open edge. Use marked routes and local direction on site.</p></aside></div>
          <figure class="vertical-figure"><img src={signPhoto} alt="A Fort Marlborough sign in a grassed setting" loading="lazy" /><figcaption>Outdoor setting and site marker. Photo: Wikimedia Commons.</figcaption></figure>
        </div>
      </div>
    </section>

    <section id="visit" class="chapter visit-section page-shell" aria-labelledby="visit-title">
      <div class="chapter-index">03<span>COME<br />PREPARED</span></div>
      <div class="chapter-body"><p class="section-label">PRACTICAL NOTES</p><h2 id="visit-title">Simple preparation, a calmer <em>visit.</em></h2><p class="visit-intro">Opening arrangements can change with events, maintenance or local management. Treat these notes as a planning checklist and confirm important details before you go.</p><div class="practical-table" role="table" aria-label="Practical visitor information"><div class="practical-row" role="row"><div role="cell"><span class="row-num">A</span><strong>Hours & admission</strong></div><p role="cell">Public listings commonly show daytime hours around <b>08:00–17:00 WIB</b>. Admission and visitor categories should be checked directly on arrival.</p><a role="cell" href={tourismSource} target="_blank" rel="noreferrer">Check source ↗</a></div><div class="practical-row" role="row"><div role="cell"><span class="row-num">B</span><strong>Best timing</strong></div><p role="cell">Morning or late afternoon is usually easier for walking. Bring water, sun protection and a compact rain layer in wet weather.</p><a role="cell" href="#faq">Read FAQ ↓</a></div><div class="practical-row" role="row"><div role="cell"><span class="row-num">C</span><strong>Parking & facilities</strong></div><p role="cell">Parking, toilets, seating and accessibility should be verified on the day; conditions may change during events.</p><a role="cell" href={mapLink} target="_blank" rel="noreferrer">Open map ↗</a></div><div class="practical-row" role="row"><div role="cell"><span class="row-num">D</span><strong>Site etiquette</strong></div><p role="cell">Use marked paths, do not climb historic structure, and take personal litter with you. A slower visit helps protect the place.</p><a role="cell" href="#history">Read context ↓</a></div></div></div>
    </section>

    <section class="journey-section" aria-labelledby="journey-title"><div class="page-shell journey-layout"><div class="journey-heading"><p class="section-label">FROM DIFFERENT DIRECTIONS</p><h2 id="journey-title">Arriving in <em>Teluk Segara.</em></h2></div><div class="journey-cards"><article><span>01</span><h3>From the airport</h3><p>From Fatmawati Soekarno Airport, continue toward central Bengkulu by taxi, ride-hailing service or hired vehicle. Check route and travel time close to departure.</p></article><article><span>02</span><h3>From terminal & city</h3><p>When using local public transport, confirm the nearest drop-off and return options. A local taxi or motorcycle taxi can bridge the last stretch.</p></article><article><span>03</span><h3>From the coast</h3><p>The fort sits near the Tapak Paderi coastal corridor. If walking from the seafront, account for heat, traffic and pavement conditions.</p></article></div></div></section>

    <section class="map-section page-shell" aria-labelledby="map-title"><div class="map-meta"><p class="section-label">POSITION</p><h2 id="map-title">One point, many routes of <em>story.</em></h2><address>Jl. Benteng, Kebun Keling, Kec. Teluk Segara,<br />Bengkulu City, Bengkulu 38116, Indonesia</address><a class="text-link" href={mapLink} target="_blank" rel="noreferrer">Open in Google Maps <span aria-hidden="true">↗</span></a></div><div class="map-frame"><iframe title="Fort Marlborough map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6878.810349279519!2d102.24910077688843!3d-3.7873176434786617!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e36afd779f07007%3A0x3c0143f4c64a7e4d!2sFort%20Marlborough!5e1!3m2!1sid!2sid!4v1787019589118!5m2!1sid!2sid" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>

    <section class="around-section chapter" aria-labelledby="around-title"><div class="page-shell around-inner"><div class="chapter-index light">04<span>NEARBY<br />TRACES</span></div><div class="chapter-body"><div class="around-heading"><p class="section-label light-label">AROUND THE FORT</p><h2 id="around-title">Carry on with <em>curiosity.</em></h2></div><div class="around-grid"><article><span>01</span><h3>Coastal setting</h3><p><strong>Tapak Paderi Beach</strong> lies along the coastal corridor near the fort. Use it as geographical context, not simply a post-photo stop.</p></article><article><span>02</span><h3>Traces of town</h3><p><strong>Kampung Cina</strong> and the old-town area help show layers of trade and urban life in Bengkulu.</p></article><article><span>03</span><h3>National history</h3><p><strong>Bung Karno Exile House</strong> can be a further stop for understanding a different period in the city's history.</p></article><article><span>04</span><h3>Travel needs</h3><p>Central Bengkulu has a range of food stalls, accommodation, convenience stores, ATMs, workshops, fuel stations and vehicle-charging points. Choose by need, without commercial recommendation.</p></article></div></div></div></section>

    <section class="food-section page-shell" aria-labelledby="food-title"><div class="food-illustration" aria-hidden="true"><div class="seal-field"><span>CITY ROUTE</span><img src="/mark.svg" alt="" width="112" height="112" /><b>03°47′14″ S</b><i></i><b>102°14′57″ E</b></div></div><div class="food-copy"><p class="section-label">FOOD & REST</p><h2 id="food-title">Pause, then find the flavour of the <em>city.</em></h2><p>For food, choose a place that suits the rhythm of your day: a simple warung for a quick meal, a family restaurant for a longer rest, or a drink stall in town. Bengkulu has a rich spice tradition; ask about ingredients if you have particular dietary needs.</p><p class="muted-note">This guide does not promote individual businesses. Opening hours, menu choices and halal or vegetarian requirements should be confirmed directly with the provider.</p></div></section>

    <section id="faq" class="chapter faq-section page-shell" aria-labelledby="faq-title"><div class="chapter-index">05<span>COMMON<br />QUESTIONS</span></div><div class="chapter-body"><p class="section-label">WHAT VISITORS OFTEN ASK</p><h2 id="faq-title">Answers before you step <em>inside.</em></h2><div class="faq-list"><details open><summary>Why was Fort Marlborough built?<span>+</span></summary><p>Bengkulu City's tourism information states that the British East India Company built the fort between 1714 and 1719 to strengthen its west-Sumatra position and protect the pepper trade.[<a href={tourismSource} target="_blank" rel="noreferrer">1</a>]</p></details><details><summary>How much time should I allow?<span>+</span></summary><p>Set aside about 60–120 minutes to walk slowly, read available interpretation and understand the direction of the spaces. Timing can vary with access and on-the-day rules.</p></details><details><summary>Should I buy a ticket beforehand?<span>+</span></summary><p>Ticket arrangements can change. Confirm directly with the manager or local tourism information before travelling.</p></details><details><summary>Is it suitable for children or older visitors?<span>+</span></summary><p>Plan the pace around individual needs, watch walking surfaces and sun exposure, and keep children close near structural edges. Ask about available access when you arrive.</p></details><details><summary>Are toilets and seating provided?<span>+</span></summary><p>Facilities may be present but their condition is not identical every day. Bengkulu City's tourism portal includes toilets and seating in its visitor-experience assessment; verify on the day of your visit.[<a href={tourismSource} target="_blank" rel="noreferrer">1</a>]</p></details></div></div></section>
  </main>

  <footer class="site-footer"><div class="page-shell footer-grid"><div class="footer-brand"><img src="/mark.svg" alt="" width="44" height="44" /><p><strong>Fort Marlborough Guide</strong><br />Reading coast, history and visitor preparation with care.</p></div><div class="footer-links"><a href={tourismSource} target="_blank" rel="noreferrer">Bengkulu City visitor information ↗</a><a href={cityTourism} target="_blank" rel="noreferrer">Bengkulu City Tourism Office ↗</a><a href={commonsSource} target="_blank" rel="noreferrer">Wikimedia Commons photo source ↗</a></div><div class="footer-legal"><a href="/en/privacy-policy/">Privacy policy</a><a href="/en/terms-of-use/">Terms of use</a><a href="/en/cookie-settings/">Cookie settings</a></div></div><div class="page-shell footer-bottom"><p>An independent, non-profit visitor-information project; not affiliated with the official site manager, government or commercial organisations.</p><p>© 2026 Fort Marlborough Guide.</p></div></footer>
  <a class="cookie-prompt" href="/en/cookie-settings/" aria-label="Manage cookies">Cookie preferences</a>
</BaseLayout>
